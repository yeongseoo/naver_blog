{
  "manifest_version": 3,
  "name": "네이버 블로그 자동 입력 (Phase 1 POC)",
  "version": "0.0.35",
  "description": "데스크톱 앱(exe) 브리지: 로컬 WebSocket으로 예약 발행 작업 수신 → RabbitWrite 발행 (빌드 #35)",
  "permissions": ["activeTab", "scripting", "storage", "debugger", "tabs", "alarms"],
  "host_permissions": [
    "https://blog.naver.com/*",
    "https://ac.search.naver.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "네이버 블로그 자동 입력",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://blog.naver.com/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["content.js"]
    }
  ]
}
